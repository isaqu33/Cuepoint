# Copie para .env  (cp .env.example .env) e troque os segredos marcados com "troque".

# ---- Portas no host ----
WEB_PORT_HOST=3300
REALTIME_PORT_HOST=3301
POSTGRES_PORT_HOST=5433
REDIS_PORT_HOST=6380
MINIO_PORT_HOST=9000
MINIO_CONSOLE_PORT_HOST=9001

# ---- PostgreSQL (o compose monta a APP_DATABASE_URL a partir destes) ----
POSTGRES_USER=cuepoint
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cuepoint

# ---- Aplicação ----
# URL do app como o navegador a enxerga (necessária para as actions do SvelteKit).
ORIGIN=http://localhost:3300
BODY_SIZE_LIMIT=Infinity
APP_HOST_EMAIL=http://localhost:3300/
# Gere com: openssl rand -hex 32
APP_JWT_SECRET_KEY=troque
APP_SYSTEM_USER_EMAIL=admin@cuepoint.local
APP_SYSTEM_USER_PASSWORD=troque

# ---- E-mail (Resend). Opcional: sem chave, o aviso de conclusão é ignorado ----
APP_RESEND_EMAIL_FROM=
APP_RESEND_EMAIL_KEY=

# ---- Storage de objetos (MinIO, compatível com S3) ----
MINIO_ACCESS_KEY=cuepoint-minio
MINIO_SECRET_KEY=troque-esta-chave-minio
# URL pela qual o NAVEGADOR acessa os arquivos
MINIO_PUBLIC_URL=http://localhost:9000

# ---- Tempo real (progresso) ----
# URL pela qual o NAVEGADOR conecta no serviço de tempo real
PUBLIC_REALTIME_URL=http://localhost:3301
# Origens do tempo real (CORS). 'web:3300' é só para o E2E em container; em produção liste apenas a origem real do app.
CORS_ORIGINS=http://localhost:3300,http://web:3300

# ---- Worker de transcrição ----
TRANSCRIPTION_CONCURRENCY=1
TRANSCRIPTION_ATTEMPTS=3
# auto = detecta o idioma; ou use pt, en, es...
WHISPER_LANGUAGE=auto
# WHISPER_THREADS=4

# Batch (padrão "processa em lotes"): horários em cron, fuso e limites
BATCH_TZ=America/Sao_Paulo
RECONCILE_CRON=*/10 * * * *
NIGHTLY_CRON=0 2 * * *
BATCH_LIMIT=100
RECONCILE_GRACE_MINUTES=10
IDEMPOTENCY_TTL_HOURS=24
EVENT_RETENTION_DAYS=90
BATCH_RUN_RETENTION_DAYS=180

# Upload direto ao storage (URL pré-assinada): limites e origens permitidas no CORS do storage
UPLOAD_MAX_AUDIO_BYTES=1073741824
UPLOAD_MAX_IMAGE_BYTES=10485760
STORAGE_CORS_ORIGINS=*

# Retenção de mídia (OPT-IN: 0 = nunca apaga). RETENTION_DRY_RUN=true só conta, sem apagar.
TRANSCRIPTION_RETENTION_DAYS=0
MEDIA_RETENTION_DAYS=0
RETENTION_DRY_RUN=false
ORPHAN_GRACE_HOURS=24
# Verificação de backup (pasta montada no worker) e relay do outbox de eventos
BACKUP_DIR=/backups
BACKUP_MAX_AGE_HOURS=26
RELAY_CRON=* * * * *

# Observabilidade: nível dos logs (debug|info|warn|error) e webhook para alertas (Slack/Teams; opcional)
LOG_LEVEL=info
ALERT_WEBHOOK_URL=
