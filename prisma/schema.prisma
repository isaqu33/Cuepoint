// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

/// Estado persistido do processamento de transcrição de uma aula.
enum TranscriptionStatus {
  IDLE
  QUEUED
  PROCESSING
  READY
  FAILED
}

model User {
  workspaceId String    @default("ws_default")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  id          String    @id @default(cuid())
  email       String    @unique
  username    String
  name        String?
  isSystem    Boolean?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  password     Password?
  groupActions Group?       @relation(fields: [groupId], references: [id])
  groupId      String?
  sessions     Session[]
  connections  Connection[]
  lesson       MediaFile[]
  boardinguser Onboarding?
  emailservice Email?

  isAdmin   Boolean?
  isBlocked Boolean? @default(false)

  groupTagsCreated GroupTag[] @relation("GroupTagsCreatedByUser")
  groupTagsUpdated GroupTag[] @relation("GroupTagsUpdatedByUser")

  tagsCreated Tag[] @relation("GroupTagsCreatedByUser")
  tagsUpdated Tag[] @relation("GroupTagsUpdatedByUser")

  courseCreated Collection[] @relation("GroupTagsCreatedByUser")
  courseUpdated Collection[] @relation("GroupTagsUpdatedByUser")

  serieCreated Subcollection[] @relation("serieCreatedByUser")
  serieUpdated Subcollection[] @relation("serieUpdatedByUser")

  authorsCreated Author[] @relation("authorsCreatedByUser")
  authorsUpdated Author[] @relation("authorsUpdatedByUser")

  LessonsCreated MediaFile[] @relation("LessonCreatedByUser")
  LessonsUpdated MediaFile[] @relation("LessonUpdatedByUser")

  transcriptCreated Transcription[] @relation("TranscriptionsCreatedByUser")
  transcriptUpdated Transcription[] @relation("TranscriptionsUpdatedByUser")

  fileCreated File[] @relation("FilesCreatedByUser")
  fileUpdated File[] @relation("FilesUpdatedByUser")
}

model AccountRequest {
  id      String @id @default(cuid())
  name    String
  email   String
  request String
}

model MediaFile {
  /// Tamanho total (áudio + imagem) em bytes, para os limites do espaço.
  sizeBytes   BigInt      @default(0)
  shareLinks  ShareLink[]
  workspaceId String      @default("ws_default")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  id          String      @id @default(cuid())
  title       String      @unique
  description String?
  photoLeson  String?
  audiofile   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPublished Boolean? @default(true)

  contetText                  LessonArticle?
  transcript                  Transcription?
  haveAnyTasncriptInProgresse Boolean?            @default(false)
  transcriptionStatus         TranscriptionStatus @default(IDLE)
  transcriptionProgress       Int                 @default(0)
  transcriptionError          String?
  createdByUserId             String?
  createdByUser               User?               @relation("LessonCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("LessonUpdatedByUser", fields: [updatedByUserId], references: [id])

  files       File[]          @relation("FileToLesson")
  tags        Tag[]           @relation("LessonToTag")
  grouptag    GroupTag[]      @relation("GroupTagToLesson")
  courses     Collection[]    @relation("CourseToLesson")
  series      Subcollection[] @relation("LessonToSerie")
  authors     Author[]        @relation("AuthorToLesson")
  attachments Attachment[]
  articles    Article[]       @relation("ArticleToLesson")

  userid String
  user   User   @relation(fields: [userid], references: [id])

  @@index([workspaceId])
  @@map("Lesson")
}

model Article {
  id          String      @id @default(cuid())
  title       String
  description String
  contet      String
  lessons     MediaFile[] @relation("ArticleToLesson")
}

model Attachment {
  id String @id @default(cuid())

  Lesson   MediaFile? @relation(fields: [lessonId], references: [id])
  lessonId String?

  serie   Subcollection? @relation(fields: [serieId], references: [id])
  serieId String?

  author   Author? @relation(fields: [authorId], references: [id])
  authorId String?

  files File[]

  course   Collection? @relation(fields: [courseId], references: [id])
  courseId String?
}

model Transcription {
  id String @id @default(cuid())

  transcription String?
  /// Legenda WebVTT com marcações de tempo (saída do motor de transcrição).
  vtt           String?
  language      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson   MediaFile? @relation(fields: [lessonId], references: [id])
  lessonId String?    @unique

  createdByUserId String?
  createdByUser   User?   @relation("TranscriptionsCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("TranscriptionsUpdatedByUser", fields: [updatedByUserId], references: [id])
}

model File {
  id String @id @default(cuid())

  size         String?
  type         String?
  name         String?
  lastModified String?
  path         String?

  lesson      MediaFile[]     @relation("FileToLesson")
  attachments Attachment[]
  series      Subcollection[] @relation("FileToSerie")
  courses     Collection[]    @relation("CourseToFile")
  authors     Author[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUserId String?
  createdByUser   User?   @relation("FilesCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("FilesUpdatedByUser", fields: [updatedByUserId], references: [id])
}

model Subcollection {
  workspaceId String       @default("ws_default")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  id          String       @id @default(cuid())
  title       String       @unique
  about       String
  isPublished Boolean?     @default(true)
  photoLeson  String?
  files       File[]       @relation("FileToSerie")
  attachments Attachment[]

  createdByUserId String?
  createdByUser   User?   @relation("serieCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("serieUpdatedByUser", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  grouptag GroupTag[]   @relation("GroupTagToSerie")
  lessons  MediaFile[]  @relation("LessonToSerie")
  tags     Tag[]        @relation("SerieToTag")
  courses  Collection[] @relation("CourseToSerie")

  authors Author[] @relation("AuthorToSerie")

  parent Subcollection[] @relation("ParentSeries")

  series Subcollection[] @relation("ParentSeries")
  // -----------------------------------------------------------------------

  @@index([workspaceId])
  @@map("Serie")
}

model Collection {
  workspaceId String    @default("ws_default")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  id          String    @id @default(cuid())
  title       String    @unique
  about       String
  photoLeson  String?

  isPublished Boolean? @default(true)

  files       File[]       @relation("CourseToFile")
  attachments Attachment[]

  createdByUserId String?
  createdByUser   User?   @relation("GroupTagsCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("GroupTagsUpdatedByUser", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  series    Subcollection[] @relation("CourseToSerie")
  lessons   MediaFile[]     @relation("CourseToLesson")
  tags      Tag[]           @relation("CourseToTag")
  groupTags GroupTag[]      @relation("CourseToGroupTag")
  authors   Author[]        @relation("AuthorToCourse")

  // Relação auto-referencial -------------------------------------------
  parent Collection[] @relation("ParentCourse")

  courses Collection[] @relation("ParentCourse")
  // ----------------------------------------------------------------------

  @@index([workspaceId])
  @@map("Course")
}

model Tag {
  id   String @id @default(cuid())
  name String

  createdByUserId String?
  createdByUser   User?   @relation("GroupTagsCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("GroupTagsUpdatedByUser", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  grouptags GroupTag[]
  courses   Collection[]    @relation("CourseToTag")
  series    Subcollection[] @relation("SerieToTag")
  lessons   MediaFile[]     @relation("LessonToTag")
  authors   Author[]
}

model GroupTag {
  id String @id @default(cuid())

  name        String
  description String

  createdByUserId String?

  createdByUser User? @relation("GroupTagsCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?

  updatedByUser User? @relation("GroupTagsUpdatedByUser", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  parent GroupTag[] @relation("ChildGroupTags")

  groupTags GroupTag[] @relation("ChildGroupTags")

  // --------------------------------------------------------------

  allTags Tag[]
  courses Collection[]    @relation("CourseToGroupTag")
  series  Subcollection[] @relation("GroupTagToSerie")
  lessons MediaFile[]     @relation("GroupTagToLesson")
  authors Author[]
}

model Author {
  id String @id @default(cuid())

  name        String?
  description String?

  photoLeson  String?
  files       File[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  createdByUserId String?
  createdByUser   User?   @relation("authorsCreatedByUser", fields: [createdByUserId], references: [id])

  updatedByUserId String?
  updatedByUser   User?   @relation("authorsUpdatedByUser", fields: [updatedByUserId], references: [id])

  series    Subcollection[] @relation("AuthorToSerie")
  lessons   MediaFile[]     @relation("AuthorToLesson")
  tags      Tag[]
  courses   Collection[]    @relation("AuthorToCourse")
  groupTags GroupTag[]
}

model LessonArticle {
  id   String @id @default(cuid())
  html String
  txt  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson   MediaFile? @relation(fields: [lessonId], references: [id])
  lessonId String?    @unique
}

model Password {
  id              String  @id @default(cuid())
  hashed_password String?

  user_id String @unique
  user    User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Email {
  id String @id @default(cuid())

  isVerified Boolean?
  verifiedAt DateTime?

  isAuthenticated Boolean?
  hasLoggedIn     Boolean?

  userId String @unique
  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model Onboarding {
  id String @id @default(cuid())

  isVerificationEmailSent Boolean?
  verificationEmailSentAt DateTime?

  hasEverSignedIn Boolean?
  firstSignedInAt DateTime?

  isforgetPasswordEmailSent Boolean?
  forgetPasswordEmailSentAt DateTime?

  userId String @unique
  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  roles Role[]
}

model Role {
  id     String @id @default(cuid())
  action String // e.g. create, read, update, delete
  entity String // e.g. create, read, update, delete

  // access      String // e.g. own or any
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group[]
}

model Verification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// The type of verification, e.g. "email" or "phone"
  type String

  /// The thing we're trying to verify, e.g. a user's email or phone number
  target String

  /// The secret key used to generate the otp
  secret String

  /// The algorithm used to generate the otp
  algorithm String

  /// The number of digits in the otp
  digits Int

  /// The number of seconds the otp is valid for
  period Int

  /// The valid characters for the otp
  charSet String

  /// When it's safe to delete this verification
  expiresAt DateTime?

  @@unique([target, type])
}

model Connection {
  id           String @id @default(cuid())
  providerName String
  providerId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@unique([providerName, providerId])
}

model Session {
  id        String    @id @default(cuid())
  user_id   String
  expiresAt DateTime
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  user User @relation(references: [id], fields: [user_id], onDelete: Cascade)

  @@index([user_id])
}

/// Log durável de eventos de domínio (publicado no tópico e consultável depois).
model EventLog {
  id          String    @id @default(cuid())
  /// Id do evento (uuid). Único: assinantes e relays podem reprocessar sem duplicar.
  eventId     String    @unique
  type        String
  aggregateId String
  version     Int       @default(1)
  data        Json
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
  /// Preenchido quando o evento chegou ao tópico. Nulo = ainda não publicado (o relay republica).
  publishedAt DateTime?
  /// Espaço de trabalho do evento (isolamento). Nulo só em linhas antigas sem dono conhecido.
  workspaceId String?

  @@index([type, occurredAt])
  @@index([publishedAt, createdAt])
  @@index([workspaceId, aggregateId, occurredAt])
  @@index([aggregateId, occurredAt])
}

/// Respostas guardadas por `Idempotency-Key`: repetir o mesmo pedido devolve a mesma resposta
/// sem criar trabalho de novo. Limpeza pelo job batch (registros com mais de 24h).
model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  scope       String
  requestHash String
  status      Int
  body        Json
  createdAt   DateTime @default(now())

  @@unique([scope, key])
  @@index([createdAt])
}

/// Log de execução dos jobs em lote (reconciliação, rotina das 02:00). Fonte do relatório de uso.
model BatchRun {
  id         String    @id @default(cuid())
  job        String
  status     String
  trigger    String
  startedAt  DateTime
  finishedAt DateTime?
  stats      Json?
  error      String?

  @@index([job, startedAt])
}

/// Espaço de trabalho: fronteira de isolamento entre equipes/clientes. Todo dado de mídia e membro pertence a um.
/// O filtro por espaço é aplicado automaticamente pela extensão do Prisma (src/server/utils/db.ts).
model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Limites opcionais (nulo = sem limite).
  maxFiles        Int?
  maxStorageBytes BigInt?
  createdAt       DateTime @default(now())

  members        User[]
  collections    Collection[]
  subcollections Subcollection[]
  mediaFiles     MediaFile[]
  shareLinks     ShareLink[]
}

/// Link temporário de leitura de um arquivo (transcrição + áudio), sem login. Só o hash do token é guardado.
model ShareLink {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  mediaFileId     String
  mediaFile       MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  createdByUserId String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  views           Int       @default(0)
  lastViewedAt    DateTime?

  @@index([mediaFileId])
  @@index([workspaceId, expiresAt])
}
