{
  "name": "cuepoint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit -- --run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint src worker prisma tests --ext .ts,.svelte --quiet",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "prettier-eslint --write 'src/**/*.{js,ts,svelte}'",
    "test:unit": "vitest",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "storage": "npx azurite",
    "vitest": "vitest",
    "build:worker": "esbuild worker/index.ts worker/subscribers.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-worker",
    "worker": "tsx worker/index.ts",
    "worker:start": "node dist-worker/index.js",
    "db:deploy": "prisma migrate deploy",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
